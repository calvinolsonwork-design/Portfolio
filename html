<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>James Alderman — Political Science</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;1,8..60,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #faf9f7;
      --surface: #ffffff;
      --text: #1a1917;
      --muted: #6b6860;
      --faint: #a8a49e;
      --border: rgba(26,25,23,0.12);
      --border-mid: rgba(26,25,23,0.22);
      --accent-bg: #e8f0f8;
      --accent-text: #0c447c;
      --tag-bg: #f0ede8;
      --tag-text: #6b6860;
      --serif: 'Playfair Display', Georgia, serif;
      --body: 'Source Serif 4', Georgia, serif;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #141412;
        --surface: #1e1d1b;
        --text: #f0ede8;
        --muted: #9e9a94;
        --faint: #6b6860;
        --border: rgba(240,237,232,0.1);
        --border-mid: rgba(240,237,232,0.2);
        --accent-bg: #0c2847;
        --accent-text: #85b7eb;
        --tag-bg: #2a2926;
        --tag-text: #9e9a94;
      }
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--body);
      background: var(--bg);
      color: var(--text);
      font-size: 16px;
      line-height: 1.7;
      font-weight: 300;
    }

    /* ── Layout ── */
    .container {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Nav ── */
    nav {
      border-bottom: 0.5px solid var(--border);
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 100;
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 0;
    }

    .nav-logo {
      font-family: var(--serif);
      font-size: 17px;
      letter-spacing: 0.01em;
      color: var(--text);
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-size: 12px;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--text); }

    /* ── Hero ── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
      padding: 5rem 0 4.5rem;
      border-bottom: 0.5px solid var(--border);
    }

    .eyebrow {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1.25rem;
    }

    h1 {
      font-family: var(--serif);
      font-size: 52px;
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 1.25rem;
    }

    h1 em { font-style: italic; }

    .hero-subtitle {
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1.75rem;
    }

    .hero-bio {
      font-size: 15.5px;
      color: var(--muted);
      line-height: 1.8;
    }

    .hero-bio strong {
      color: var(--text);
      font-weight: 400;
    }

    .hero-right {
      padding-top: 2.5rem;
    }

    .stat-stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .stat-item {
      border-left: 2px solid var(--border-mid);
      padding-left: 1.25rem;
    }

    .stat-num {
      font-family: var(--serif);
      font-size: 32px;
      font-weight: 400;
      line-height: 1;
      margin-bottom: 4px;
    }

    .stat-desc {
      font-size: 12px;
      color: var(--muted);
      letter-spacing: 0.04em;
    }

    /* ── Section header ── */
    .section-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin: 4rem 0 2rem;
    }

    .section-head h2 {
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 400;
      white-space: nowrap;
    }

    .section-rule {
      flex: 1;
      height: 0.5px;
      background: var(--border);
    }

    .section-count {
      font-size: 11px;
      color: var(--faint);
      letter-spacing: 0.06em;
      white-space: nowrap;
    }

    /* ── Projects ── */
    .project-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-bottom: 4rem;
    }

    .project-card {
      background: var(--surface);
      border: 0.5px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: border-color 0.2s;
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .project-card:hover { border-color: var(--border-mid); }

    .project-tag {
      display: inline-block;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--tag-text);
      background: var(--tag-bg);
      padding: 3px 9px;
      border-radius: 4px;
      margin-bottom: 0.9rem;
    }

    .featured-badge {
      display: inline-block;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent-text);
      background: var(--accent-bg);
      padding: 3px 10px;
      border-radius: 4px;
      margin-bottom: 0.9rem;
    }

    .project-card h3 {
      font-family: var(--serif);
      font-size: 17px;
      font-weight: 400;
      line-height: 1.35;
      margin-bottom: 0.7rem;
    }

    .project-card p {
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.65;
      margin-bottom: 1.1rem;
    }

    .project-footer {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 11px;
      color: var(--faint);
      letter-spacing: 0.03em;
      flex-wrap: wrap;
    }

    .dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--faint);
      flex-shrink: 0;
    }

    /* Featured card spans full width */
    .featured {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 3fr 1fr;
      gap: 2.5rem;
    }

    .featured h3 { font-size: 21px; }

    .featured-meta {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding-left: 2rem;
      border-left: 0.5px solid var(--border);
    }

    .meta-label {
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
      margin-bottom: 3px;
    }

    .meta-val {
      font-family: var(--serif);
      font-size: 15px;
    }

    /* ── Resume ── */
    .resume-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 0.5px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 4rem;
    }

    .resume-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .resume-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: var(--tag-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .resume-icon svg { opacity: 0.6; }

    .resume-title { font-size: 15px; font-weight: 400; }
    .resume-sub { font-size: 12px; color: var(--muted); margin-top: 1px; }

    .download-btn {
      display: flex;
      align-items: center;
      gap: 7px;
      font-family: var(--body);
      font-size: 12px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 9px 20px;
      border: 0.5px solid var(--border-mid);
      border-radius: 8px;
      cursor: pointer;
      background: transparent;
      color: var(--text);
      text-decoration: none;
      transition: background 0.2s;
      white-space: nowrap;
    }

    .download-btn:hover { background: var(--tag-bg); }

    /* ── Contact ── */
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 5rem;
    }

    .contact-item {
      border: 0.5px solid var(--border);
      border-radius: 10px;
      padding: 1.1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s;
    }

    .contact-item:hover { border-color: var(--border-mid); }

    .contact-item svg { opacity: 0.5; flex-shrink: 0; }

    .contact-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--faint);
      margin-bottom: 3px;
    }

    .contact-val { font-size: 13.5px; }

    /* ── Footer ── */
    footer {
      border-top: 0.5px solid var(--border);
      padding: 2rem 0;
      text-align: center;
      font-size: 12px;
      color: var(--faint);
      letter-spacing: 0.04em;
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      h1 { font-size: 36px; }
      .hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 0; }
      .hero-right { padding-top: 0; }
      .stat-stack { flex-direction: row; flex-wrap: wrap; gap: 1rem; }
      .project-grid { grid-template-columns: 1fr; }
      .featured { grid-template-columns: 1fr; }
      .featured-meta { border-left: none; border-top: 0.5px solid var(--border); padding-left: 0; padding-top: 1rem; flex-direction: row; flex-wrap: wrap; gap: 1.25rem; }
      .contact-grid { grid-template-columns: 1fr; }
      .nav-links { gap: 1.25rem; }
    }
  </style>
</head>
